---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const texts = [
  ...(await getCollection('texts', ({ data }) => !data.draft)).map((entry) => ({ entry, kind: 'texts' })),
  ...(await getCollection('blog', ({ data }) => !data.draft)).map((entry) => ({ entry, kind: 'blog' })),
].sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf());
---
<BaseLayout title="Peter Vale — Personal Site" description="Projects, thoughts, ideas, lessons and wins from Peter Vale.">
  <main class="page">
    <section class="hero" aria-label="Introduction">
      <div class="chain" aria-label="Interactive AFC II chain">
        <div class="chain-canvas" id="canvas-wrap">
          <canvas id="scene" aria-label="Interactive AFC II chain and cross. Move or drag to explore."></canvas>
          <canvas id="ascii-layer" aria-hidden="true"></canvas>
          <p id="fallback" hidden>Interactive chain requires a browser with WebGL 2.</p>
        </div>
        <button id="reset" type="button" aria-label="Reset chain position">RESET VIEW ↺</button>
      </div>

      <div class="about">
        <h1>Peter Vale</h1>
        <p>I'm a creative founder,<br />learning and building in public.</p>
        <p>This site is home to my projects,<br />thoughts, ideas, lessons and wins.</p>
        <p>P.S. The site will grow as I do.</p>
        <div class="social-links">
          <a href="https://x.com/messages/compose?recipient_id=2093414733084852224" target="_blank" rel="noopener noreferrer">Work with me!</a>
          <a href="https://x.com/ex31sdg" target="_blank" rel="noopener noreferrer" aria-label="Peter Vale on X">X.</a>
        </div>
      </div>

      <div class="portrait">
        <img src={`${base}portrait.png`} alt="ASCII portrait of Peter Vale" width="902" height="1320" fetchpriority="high" />
      </div>
    </section>

    <section class="work" aria-labelledby="work-title">
      <h2 id="work-title">Projects &amp; texts</h2>
      <div class="work-columns">
        <div class="work-column">
          <h3>PROJECTS</h3>
          <ol>
            {projects.map((entry, index) => (
              <li>
                <a href={entry.data.externalUrl ?? `${base}projects/${entry.id}/`}>
                  <span class="number">{String(index + 1).padStart(2, '0')}</span>
                  <span class="item-title">{entry.data.title}</span>
                  <span class="arrow" aria-hidden="true">&gt;</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
        <div class="work-column">
          <h3>TEXTS</h3>
          <ol>
            {texts.map((item, index) => (
              <li>
                <a href={item.entry.data.externalUrl ?? `${base}${item.kind}/${item.entry.id}/`}>
                  <span class="number">{String(index + 1).padStart(2, '0')}</span>
                  <span class="item-title">{item.entry.data.title}</span>
                  <span class="arrow" aria-hidden="true">&gt;</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <footer class="signature">
      <img src={`${base}signature.png`} alt="Peter Vale signature" width="6814" height="2160" loading="lazy" />
    </footer>
  </main>
  <script src={`${base}necklace-animation/scene.js`} defer is:inline></script>
</BaseLayout>

<style>
  .page { width: min(100%, 1463px); min-height: 1791px; margin: 0 auto; padding: 138px 8.4% 36px; background: #fff; }
  .hero { display: grid; grid-template-columns: 39% 38% 23%; align-items: start; min-height: 480px; }
  .chain { position: relative; width: min(100%, 420px); height: 430px; margin: -41px 0 0 -11px; }
  .chain-canvas { position: absolute; inset: 0; overflow: hidden; }
  #scene, #ascii-layer { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
  #scene { opacity: 0; cursor: grab; }
  #scene:active { cursor: grabbing; }
  #ascii-layer { pointer-events: none; }
  #fallback { position: absolute; top: 35%; padding: 1rem; font-size: 12px; line-height: 1.6; }
  #reset { position: absolute; left: 50%; top: 105%; transform: translateX(-50%); padding: 7px 4px; border: 0; background: none; color: #435b98; font: inherit; font-size: 10px; letter-spacing: .04em; cursor: pointer; opacity: .68; white-space: nowrap; }
  #reset:hover { opacity: 1; text-decoration: underline; }
  .about { padding-top: 14px; font-size: 20px; line-height: 1.28; }
  h1, h2, h3, p { margin: 0; font-weight: 400; }
  h1 { font-size: 48px; line-height: 1.2; margin-bottom: 20px; letter-spacing: 0; white-space: nowrap; }
  .about p { margin-bottom: 17px; }
  .social-links { display: flex; flex-direction: column; align-items: flex-start; gap: 17px; margin-top: 22px; }
  .social-links a { text-decoration: none; }
  .social-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .portrait { width: 100%; max-width: 275px; align-self: start; margin: -23px 0 0 -5px; }
  .portrait img { width: 100%; height: auto; display: block; }
  .work { margin-top: 90px; }
  .work h2 { font-size: 39px; line-height: 1.2; margin-bottom: 47px; }
  .work-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 10.4%; }
  .work-column h3 { font-size: 18px; line-height: 1.3; margin-bottom: 18px; }
  .work-column ol { list-style: none; padding: 0; margin: 0; }
  .work-column li { margin-bottom: 12px; font-size: 17px; line-height: 1.45; }
  .work-column li a { display: grid; grid-template-columns: 46px 1fr 24px; align-items: baseline; gap: 3px; min-height: 23px; text-decoration: none; }
  .work-column li a:hover .item-title { text-decoration: underline; text-underline-offset: 3px; }
  .arrow { text-align: right; }
  .signature { margin: 356px 0 0 30px; width: calc(100% - 60px); }
  .signature img { display: block; width: 100%; height: auto; }
  @media (max-width: 1100px) {
    .page { padding: 90px 6% 35px; min-height: 0; }
    .hero { grid-template-columns: 37% 39% 24%; min-height: 460px; }
    .chain { height: 380px; }
    h1 { font-size: clamp(29px, 3.2vw, 48px); }
    .about { font-size: clamp(12px, 1.3vw, 20px); }
    .work { margin-top: 50px; }
    .work h2 { font-size: 32px; }
    .work-column li { font-size: 14px; }
    .signature { margin-top: 220px; }
  }
  @media (max-width: 680px) {
    .page { width: 100%; padding: 34px 7.5% 30px; }
    .hero { display: flex; flex-direction: column; min-height: 0; }
    .chain { order: 1; width: min(100%, 390px); height: min(105vw, 430px); margin: 0 auto 75px; align-self: center; }
    .about { order: 2; padding: 0; font-size: clamp(14px, 3.8vw, 18px); line-height: 1.38; }
    h1 { font-size: clamp(32px, 9vw, 48px); margin-bottom: 24px; }
    .about p { margin-bottom: 17px; }
    .social-links { gap: 14px; margin-top: 21px; }
    .portrait { order: 3; align-self: center; width: min(70%, 315px); max-width: none; margin: 52px 0 30px; }
    .work { margin-top: 0; }
    .work h2 { font-size: clamp(25px, 6.6vw, 34px); margin-bottom: 32px; }
    .work-columns { grid-template-columns: 1fr; gap: 46px; }
    .work-column h3 { font-size: 12px; margin-bottom: 16px; }
    .work-column li { font-size: clamp(12px, 3.3vw, 15px); margin-bottom: 15px; }
    .work-column li a { grid-template-columns: 30px 1fr 16px; }
    .signature { margin: 110px 0 0; width: 100%; }
    .signature img { width: 108%; max-width: none; margin-left: -4%; }
  }
</style>
